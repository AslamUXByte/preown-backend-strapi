{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "price": {
      "type": "decimal"
    },
    "description": {
      "type": "blocks"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Isfeatured": {
      "type": "boolean"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "oldPrice": {
      "type": "decimal"
    },
    "colors": {
      "type": "json"
    },
    "storage": {
      "type": "json"
    },
    "condition": {
      "type": "enumeration",
      "enum": [
        "Excellent",
        "Good",
        "Fair",
        "Poor"
      ]
    }
  }
}