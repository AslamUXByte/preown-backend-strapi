{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "new_products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::new-product.new-product",
      "mappedBy": "order"
    },
    "users_permissions_users": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "order"
    },
    "user_address": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-address.user-address",
      "inversedBy": "orders"
    },
    "TotalAmount": {
      "type": "decimal"
    },
    "RazorpayOrderId": {
      "type": "string"
    },
    "RazorpayPaymentId": {
      "type": "string"
    },
    "PaymentStatus": {
      "type": "enumeration",
      "enum": [
        "PENDING",
        "PAID",
        "FAILED"
      ]
    },
    "OrderStatus": {
      "type": "enumeration",
      "enum": [
        "Ordered",
        "Packed",
        "Shipped",
        "Delivered",
        "Cancelled"
      ]
    }
  }
}
